{
  "name": "noko",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch daemon/src/main.ts",
    "start": "node daemon/src/main.ts",
    "ui": "node ui/run.ts",
    "ui:dev": "node ui/run.ts --watch",
    "build": "tsc -p . && tsc -p ui/tsconfig.gnim.json && tsc -p ui && node ui/run.ts --build-only",
    "test": "node --test 'daemon/test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "gnim": "1.9.1",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@girs/gjs": "5.4.0",
    "@girs/gtk-4.0": "5.4.0",
    "@girs/gtk4layershell-1.0": "5.4.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
