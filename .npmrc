# Aucun script d'installation (preinstall/postinstall…) : voir CLAUDE.md, section Dépendances.
ignore-scripts=true
# Quarantaine : ne jamais résoudre une version publiée il y a moins de 7 jours.
min-release-age=7
engine-strict=true
# Ne pas installer automatiquement les peerDependencies : le point d'entrée du SDK Agent
# n'importe que des modules Node. Évite ~60 paquets (SDK MCP, express, hono…) inutiles.
legacy-peer-deps=true
